{
  "name": "seniorproject",
  "version": "1.0.0",
  "description": "A web api using Node.js and TypeScript built for San Juan Theater",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "watch:app": "nodemon src/server.ts",
    "test": "jest --config jest.config.ts --coverage",
    "compile:sass": "sass themes/style.scss public/css/style.css",
    "watch:sass": "npm run compile:sass -- --watch",
    "dev": "npm-run-all --parallel watch:sass watch:app"
  },
  "author": "Katrina L. Lyman",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-openid-connect": "^3.4.0",
    "express-validator": "^7.0.1",
    "mongodb": "^7.6.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.6",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.75.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
