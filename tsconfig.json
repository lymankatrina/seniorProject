{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",

    "esModuleInterop": true,

    "strict": true,
    "noImplicitAny": true,

    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",

    "allowJs": true,
  
    "resolveJsonModule": true
},
  "include": ["src/**/*", "public-src/**/*"]
}
